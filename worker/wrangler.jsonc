{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llm-cors-proxy",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-24",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://xiaojiecode.github.io,http://localhost:5173,http://127.0.0.1:5173",
    "ALLOWED_HOSTS": "lucen.cc"
  }
}
